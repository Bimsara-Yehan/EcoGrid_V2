# Root ignores for monorepo (frontend + backend)

# Node
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
coverage/
.cache/
.vite/
.eslintcache

# TypeScript
*.tsbuildinfo

# Env/Secrets
.env
.env.*
!.env.example

# OS/Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
logs/
*.log

# Local data
tmp/
temp/

# Frontend artifacts
frontend/.vite/
frontend/dist/

# Backend artifacts
backend/dist/
backend/.env


# Python virtual environments
backend/vendor/incineration/ai-service/.venv*/

# Model artifacts / data (prefer Git LFS instead)
backend/vendor/**/models/*.joblib
backend/vendor/**/models/*.pkl
backend/vendor/**/data/*.csv
